{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiGatewayRef": {
    "BaseUrl": "https://localhost:7001/"
  },
  "Keycloak": {
    "realm": "csapigateway",
    "auth-server-url": "http://localhost:2080/",
    "ssl-required": "none",
    "resource": "cs-webportal",
    "verify-token-audience": true,
    "credentials": {
      "secret": ""
    }
  }
}
