{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "userRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "orderRoute": {
        "ClusterId": "orderCluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "productRoute": {
        "ClusterId": "productCluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "orderCluster": {
        "HttpClient": {
          "SslProtocols": [
            "Tls11",
            "Tls12"
          ],
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "cs.apigateway.ordersmicroservice": {
            "Address": "https://cs.apigateway.ordersmicroservice:6001" // Order service is running on port 6001
          }
        }
      },
      "productCluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpClient": {
          "SslProtocols": [
            "Tls11",
            "Tls12"
          ],
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "cs.apigateway.productsmicroservice": {
            "Address": "https://cs.apigateway.productsmicroservice:5001" // Product service is running on port 5001
          },
          "cs.apigateway.productsmicroservice2": {
            "Address": "https://cs.apigateway.productsmicroservice2:5101" // Product service is running on port 5101
          },
          "cs.apigateway.productsmicroservice3": {
            "Address": "https://cs.apigateway.productsmicroservice3:5201" // Product service is running on port 5201
          }
        }
      },
      "userCluster": {
        "HttpClient": {
          "SslProtocols": [
            "Tls11",
            "Tls12"
          ],
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "cs.apigateway.usersmicroservice": {
            "Address": "https://cs.apigateway.usersmicroservice:4000/" // User service is running on port 4001
          }
        }
      }
    }
  }
}
