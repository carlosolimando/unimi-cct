{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "MetadataAddress": "http://keycloak:8080/realms/csapigateway/.well-known/openid-configuration",
    "ValidIssuer": "http://localhost:2080/realms/csapigateway",
    "Audience": "cs-usersapi-service"
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "userRoute": {
        "ClusterId": "userCluster",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "usersRateLimiterPolicy",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "basketImemRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/api/basketitems/{**catch-all}"
        }
      },
      "orderRoute": {
        "ClusterId": "orderCluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "orderLineRoute": {
        "ClusterId": "orderCluster",
        "Match": {
          "Path": "/api/orderlines/{**catch-all}"
        }
      },
      "productRoute": {
        "ClusterId": "productCluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "orderCluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/api/orders/health"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        },
        "HttpClient": {
          "SslProtocols": [
            "Tls11",
            "Tls12"
          ],
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "cs.apigateway.ordersmicroservice": {
            "Address": "https://cs.apigateway.ordersmicroservice:6001" // Order service is running on port 6001
          }
        }
      },
      "productCluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/api/products/health"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HttpClient": {
          "SslProtocols": [
            "Tls11",
            "Tls12"
          ],
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "cs.apigateway.productsmicroservice": {
            "Address": "https://cs.apigateway.productsmicroservice:5001" // Product service is running on port 5001
          },
          "cs.apigateway.productsmicroservice2": {
            "Address": "https://cs.apigateway.productsmicroservice2:5101" // Product service is running on port 5101
          },
          "cs.apigateway.productsmicroservice3": {
            "Address": "https://cs.apigateway.productsmicroservice3:5201" // Product service is running on port 5201
          }
        }
      },
      "userCluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/api/users/health"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        },
        "HttpClient": {
          "SslProtocols": [
            "Tls11",
            "Tls12"
          ],
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "cs.apigateway.usersmicroservice": {
            "Address": "https://cs.apigateway.usersmicroservice:4001/" // User service is running on port 4001
          }
        }
      }
    }
  }
}
